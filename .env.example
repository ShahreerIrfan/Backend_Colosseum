# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGIN=*

# MongoDB Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/colosseum_db
MONGODB_DB_NAME=colosseum_db
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# Cloudinary Media CDN Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
MEDIA_STORAGE_DRIVER=cloudinary
LOCAL_ASSET_BASE_URL=http://localhost:3000/assets

# Authentication & Security (Future Admin CMS)
JWT_SECRET=super_secret_jwt_key_colosseum_2026_change_in_prod
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@colosseumtour.it
ADMIN_DEFAULT_PASSWORD=ChangeMeColosseum2026!

# Tour Versioning & Delta Sync
TOUR_CONTENT_VERSION=1.0.0
