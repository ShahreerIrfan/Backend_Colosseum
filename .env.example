# Server Configuration
PORT=3000
NODE_ENV=production
API_PREFIX=/api/v1

# CORS Configuration (comma-separated origins for production, or * for open access)
CORS_ORIGIN=*

# MongoDB Database Configuration (Required in Dokploy)
MONGODB_URI=mongodb://127.0.0.1:27017/colosseum_db
MONGODB_DB_NAME=colosseum_db
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# Redis Cache Configuration (Optional - falls back to cache bypass if unavailable)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary Media CDN Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
MEDIA_STORAGE_DRIVER=cloudinary
LOCAL_ASSET_BASE_URL=http://localhost:3000/assets

# Authentication & Security (Change JWT_SECRET and ADMIN_DEFAULT_PASSWORD in Dokploy!)
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@colosseumtour.it
ADMIN_DEFAULT_PASSWORD=ChangeMeColosseum2026!

# Tour Versioning & Delta Sync
TOUR_CONTENT_VERSION=1.0.0
